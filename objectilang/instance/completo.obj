object figura(val nombre: String) {
  method area(): Int {
    val a = 0
  }
  method describir(): String {
    val texto = "figura ${nombre}"
  }
}

object punto extends figura (val x: Int, var y: Int) {
  method suma(): Int {
    val r = x + y
  }
  override describir(): String {
    val texto = "punto en ${x}"
  }
}

object caja[+t, -u, v](var contenido: t) {
  method obtener(): t {
    val c = contenido
  }
}

object vacio()

object contador

